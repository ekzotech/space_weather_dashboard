{
  "openapi": "3.1.0",
  "info": {
    "title": "Space Weather Dashboard API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Process readiness",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  }
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/api/kp": {
      "get": {
        "summary": "Observed planetary Kp",
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Feed-Received-At": {
                "description": "UTC timestamp of the upstream response",
                "schema": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "X-Feed-Stale": {
                "description": "Whether a previous response was served after a refresh failure",
                "schema": {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Sample"
                  }
                },
                "example": [
                  {
                    "time": "2026-01-01T00:00:00Z",
                    "value": 6.33
                  }
                ]
              }
            }
          },
          "502": {
            "description": "Upstream failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Upstream rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Upstream timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/forecast": {
      "get": {
        "summary": "Upcoming Kp windows",
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Feed-Received-At": {
                "description": "UTC timestamp of the upstream response",
                "schema": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "X-Feed-Stale": {
                "description": "Whether a previous response was served after a refresh failure",
                "schema": {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Sample"
                  }
                },
                "example": [
                  {
                    "time": "2026-01-01T00:00:00Z",
                    "value": 6.33
                  }
                ]
              }
            }
          },
          "502": {
            "description": "Upstream failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Upstream rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Upstream timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/xray": {
      "get": {
        "summary": "GOES long-band X-ray flux in W/m²",
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Feed-Received-At": {
                "description": "UTC timestamp of the upstream response",
                "schema": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "X-Feed-Stale": {
                "description": "Whether a previous response was served after a refresh failure",
                "schema": {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Sample"
                  }
                },
                "example": [
                  {
                    "time": "2026-01-01T00:00:00Z",
                    "value": 0.000002
                  }
                ]
              }
            }
          },
          "502": {
            "description": "Upstream failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Upstream rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Upstream timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/storms": {
      "get": {
        "summary": "DONKI storms ordered by descending peak Kp",
        "parameters": [
          {
            "name": "min_kp",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 5,
              "maximum": 9,
              "default": 5
            },
            "required": false
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "description": "UTC date. Supply both boundaries for a range of at most 30 calendar days.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "description": "UTC date. Supply both boundaries for a range of at most 30 calendar days.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Feed-Received-At": {
                "description": "UTC timestamp of the upstream response",
                "schema": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "X-Feed-Stale": {
                "description": "Whether a previous response was served after a refresh failure",
                "schema": {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Storm"
                  }
                },
                "example": [
                  {
                    "id": "GST-001",
                    "start": "2026-01-01T00:00:00Z",
                    "peak_kp": 6.33,
                    "level": 2,
                    "linked_events": [
                      "CME-001"
                    ],
                    "peak_source": null
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Upstream failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Upstream rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Upstream timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/aurora": {
      "get": {
        "summary": "OVATION estimate for the nearest grid cell",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "required": true
          },
          {
            "name": "lon",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Feed-Received-At": {
                "description": "UTC timestamp of the upstream response",
                "schema": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "X-Feed-Stale": {
                "description": "Whether a previous response was served after a refresh failure",
                "schema": {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuroraEstimate"
                },
                "example": {
                  "probability": null,
                  "observation_time": "2020-01-01T00:00:00Z",
                  "forecast_time": "2020-01-01T00:30:00Z",
                  "stale": true,
                  "grid_distance_km": null,
                  "sun_elevation_deg": null
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Upstream failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Upstream rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Upstream timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/cloud": {
      "get": {
        "summary": "Current Open-Meteo cloud cover for the selected coordinates",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "required": true
          },
          {
            "name": "lon",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Cloud cover and UTC timestamp without offset",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "cloud_cover",
                    "time"
                  ],
                  "properties": {
                    "cloud_cover": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 100
                    },
                    "time": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "cloud_cover": 45,
                  "time": "2026-01-01T00:00"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Upstream failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Upstream rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Upstream timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Sample": {
        "type": "object",
        "required": [
          "time",
          "value"
        ],
        "properties": {
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "value": {
            "type": "number"
          }
        }
      },
      "Storm": {
        "type": "object",
        "required": [
          "id",
          "start",
          "peak_kp",
          "level",
          "linked_events",
          "peak_source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "peak_kp": {
            "type": "number",
            "minimum": 5,
            "maximum": 9
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "linked_events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "peak_source": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AuroraEstimate": {
        "type": "object",
        "required": [
          "probability",
          "observation_time",
          "forecast_time",
          "stale",
          "grid_distance_km",
          "sun_elevation_deg"
        ],
        "properties": {
          "probability": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "observation_time": {
            "type": "string",
            "format": "date-time"
          },
          "forecast_time": {
            "type": "string",
            "format": "date-time"
          },
          "stale": {
            "type": "boolean"
          },
          "grid_distance_km": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "sun_elevation_deg": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -90,
            "maximum": 90
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
